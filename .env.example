# Required local database settings
POSTGRES_USER=bpo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bpo_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Unified platform. Replace all three values before any shared deployment.
PLATFORM_ENVIRONMENT=development
PLATFORM_API_PORT=18080
PLATFORM_CONSOLE_PORT=18081
PLATFORM_JWT_SECRET=change-me-with-at-least-32-random-characters
PLATFORM_SEED_DEMO=true
PLATFORM_SEED_ADMIN_EMAIL=admin@pilot.example
PLATFORM_SEED_ADMIN_PASSWORD=change-me-pilot-password
PLATFORM_SEED_CHAT_WIDGET_KEY=change-me-widget-key
PLATFORM_CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:18081

# Asterisk extension point. Keep aligned with asterisk/conf/ari.conf.
ARI_URL=http://asterisk:8088/ari
ARI_USER=asterisk
ARI_PASSWORD=change-me-ari-password
ARI_APP=assist_app

# Optional legacy/external profiles only
GROQ_API_KEY=
GROQ_REALTIME_ASR_MODEL=whisper-large-v3
GROQ_FINAL_ASR_MODEL=whisper-large-v3
GROQ_GUIDANCE_MODEL=openai/gpt-oss-20b
GROQ_QA_MODEL=openai/gpt-oss-20b
USD_TO_INR=84
REALTIME_WS_PORT=8765
AGENT_UI_PORT=18082
METABASE_SITE_URL=http://localhost:3000
MB_DB_FILE=/metabase-data/metabase.db
METABASE_ADMIN_EMAIL=admin@bpo-pilot.local
METABASE_ADMIN_PASSWORD=change-me-metabase-password
METABASE_PORT=3000
