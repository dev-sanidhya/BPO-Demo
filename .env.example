# Groq API key — https://console.groq.com/keys
# Used for Whisper transcription + Llama-based QA scoring and real-time nudges.
GROQ_API_KEY=

# Postgres
POSTGRES_USER=bpo
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=bpo_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Asterisk ARI (must match asterisk/conf/ari.conf)
ARI_URL=http://asterisk:8088/ari
ARI_USER=asterisk
ARI_PASSWORD=changeme_ari_password
ARI_APP=assist_app

# Metabase
METABASE_SITE_URL=http://localhost:3000
MB_DB_FILE=/metabase-data/metabase.db
METABASE_ADMIN_EMAIL=admin@bpo-pilot.local
METABASE_ADMIN_PASSWORD=ChangeMe123!Pilot

# Ports exposed on the host
AGENT_UI_PORT=8080
REALTIME_WS_PORT=8765
METABASE_PORT=3000

# Unified platform API. Change both secrets before any non-local deployment.
PLATFORM_ENVIRONMENT=development
PLATFORM_API_PORT=18080
PLATFORM_CONSOLE_PORT=18081
PLATFORM_JWT_SECRET=change-me-with-at-least-32-random-characters
PLATFORM_SEED_DEMO=true
PLATFORM_SEED_ADMIN_EMAIL=admin@pilot.example
PLATFORM_SEED_ADMIN_PASSWORD=ChangeMe123!Pilot
PLATFORM_SEED_CHAT_WIDGET_KEY=pilot-widget-key-change-me
PLATFORM_CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:18081
