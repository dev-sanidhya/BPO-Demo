{
  "name": "@bpo-platform/console",
  "version": "0.1.0",
  "description": "Aperture CX unified BPO agent desktop and operations portal",
  "author": "Atharva Singh",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e:electron": "node tests/electron.e2e.mjs",
    "test:e2e:packaged": "node tests/packaged.e2e.mjs",
    "test:e2e:web": "node tests/web.e2e.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "in.aperture.bpo",
    "productName": "Aperture CX Agent",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
